# Copy to .env (gitignored) and fill in from DagsHub -> your repo -> "Remote" -> "Experiments"
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/<repo-name>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
# Fail instead of silently logging to a local store if the variables above are missing
REQUIRE_REMOTE_TRACKING=1
